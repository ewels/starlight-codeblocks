---
import '@shikijs/magic-move/style.css';
import { getRegistry } from '../registry.ts';
import { firstOnPage, scrollycoding, scrollyStyles } from './scrolly.ts';

interface Props {
  /** The side of the code in the two-column layout. The default is `right`. */
  codeSide?: 'left' | 'right';
}

const { codeSide } = Astro.props;
if (codeSide !== undefined && codeSide !== 'left' && codeSide !== 'right') {
  throw new Error(`<Scrollycoding codeSide="${codeSide}">: codeSide must be "left" or "right".`);
}
const options = getRegistry()?.options;
const html = scrollycoding(await Astro.slots.render('default'), {
  interactive: options?.scrollycoding !== false,
  animate: options?.transitions !== false,
  codeSide,
});
---

<Fragment set:html={html} />

<script>
  import './scrolly-client.ts';
</script>

{firstOnPage(Astro.request) && <style is:inline set:html={scrollyStyles} />}

<style is:global>
  .scb-scrolly {
    container-type: inline-size;
  }
  .scb-scrolly-step + .scb-scrolly-step {
    margin-top: 1.5rem;
  }
  .scb-scrolly-text > :first-child {
    margin-top: 0;
  }
  .scb-scrolly-text + .expressive-code {
    margin-top: 0.75rem;
  }
  .scb-scrolly-code {
    display: none;
  }
  .scb-scrolly-code > .expressive-code:not(.scb-scrolly-current) {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .scb-scrolly-step {
      transition: opacity 0.25s;
    }
  }
</style>
