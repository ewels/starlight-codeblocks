{
  "name": "starlight-codeblocks",
  "version": "0.0.0",
  "description": "A Starlight plugin that adds focus, line states, comment notation, annotations, API auto-linking and more features to code blocks, on top of Expressive Code.",
  "keywords": [
    "withastro",
    "starlight-plugin",
    "expressive-code",
    "astro",
    "starlight",
    "code-blocks",
    "syntax-highlighting",
    "documentation"
  ],
  "author": {
    "name": "Phil Ewels",
    "url": "https://github.com/ewels"
  },
  "homepage": "https://ewels.github.io/starlight-codeblocks/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ewels/starlight-codeblocks.git",
    "directory": "packages/starlight-codeblocks"
  },
  "bugs": {
    "url": "https://github.com/ewels/starlight-codeblocks/issues"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./expressive-code": {
      "types": "./dist/expressive-code/index.d.mts",
      "default": "./dist/expressive-code/index.mjs"
    },
    "./adapters/python": {
      "types": "./dist/adapters/python.d.mts",
      "default": "./dist/adapters/python.mjs"
    },
    "./adapters/nextflow": {
      "types": "./dist/adapters/nextflow.d.mts",
      "default": "./dist/adapters/nextflow.mjs"
    },
    "./runtimes/pyodide": {
      "types": "./dist/runtimes/pyodide.d.mts",
      "default": "./dist/runtimes/pyodide.mjs"
    },
    "./components": {
      "types": "./src/components/index.ts",
      "default": "./src/components/index.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/reference.ts",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@astrojs/starlight": ">=0.42.0",
    "astro": ">=7.0.0"
  },
  "dependencies": {
    "@expressive-code/core": "^0.44.2",
    "@expressive-code/plugin-frames": "^0.44.2",
    "@shikijs/magic-move": "^4.4.3",
    "expressive-code": "^0.44.2",
    "hast-util-from-html": "^2.0.3",
    "lz-string": "^1.5.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/starlight": "0.42.4",
    "@expressive-code/plugin-line-numbers": "0.44.2",
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.4",
    "astro": "7.3.5",
    "satteri": "0.10.5",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
