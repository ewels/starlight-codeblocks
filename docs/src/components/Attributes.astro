---
import { attributes } from './reference.ts';
import { featureLink } from './feature-link.ts';
import ReferenceEntry from './ReferenceEntry.astro';
---

{
  attributes.map(({ id, syntax, description, page, example }) => (
    <ReferenceEntry
      id={id}
      labels={syntax}
      description={description}
      facts={[['Feature', featureLink(page)]]}
      example={example}
    />
  ))
}
