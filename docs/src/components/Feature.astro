---
import { Icon } from '@astrojs/starlight/components';
import { getEntry } from 'astro:content';
import { pageHref } from './feature-link.ts';

interface Props {
  /** The id of the feature page, such as `features/focus`. */
  page: string;
  /** Takes the height the example needs, instead of the shared height of the other slides. */
  tall?: boolean;
}

const { page, tall = false } = Astro.props;
const entry = await getEntry('docs', page);
if (!entry) throw new Error(`<Feature> names a missing page: ${page}`);
const { title, description = '' } = entry.data;
---

<section class:list={['slide', { tall }]} data-feature={page} aria-roledescription="slide" aria-label={title}>
  <div class="head">
    <div class="text">
      <h3>{title}</h3>
      <p class="summary">{description}</p>
    </div>
    <a class="docs-link" href={pageHref(page)}>
      Read docs<span class="sr-only">: {title}</span>
      <Icon name="right-arrow" />
    </a>
  </div>
  <div class="body"><slot /></div>
</section>

<style>
  .slide {
    display: flex;
    flex-direction: column;
    grid-area: 1 / 1;
    min-width: 0;
  }
  .slide:global([data-current]) {
    transition: opacity 0.3s;
  }
  .slide > :global(* + *) {
    margin-top: 1rem;
  }
  .head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .text {
    min-width: 0;
  }
  h3 {
    margin: 0;
    font-size: var(--sl-text-h3);
  }
  .summary {
    margin-top: 0.25rem;
    color: var(--sl-color-gray-2);
  }
  .body {
    flex: 1;
  }
  .body > :global(* + *) {
    margin-top: 1rem;
  }
  .docs-link {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.375rem;
    min-height: 2rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999rem;
    color: var(--sl-color-white);
    font-weight: 600;
    font-size: var(--sl-text-sm);
    line-height: 1.3;
    text-decoration: none;
    white-space: nowrap;
  }
  .docs-link:hover {
    border-color: var(--sl-color-gray-2);
  }
  .docs-link :global(svg) {
    display: block;
    width: 1rem;
    height: 1rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .slide:global([data-current]) {
      transition: none;
    }
  }
</style>
