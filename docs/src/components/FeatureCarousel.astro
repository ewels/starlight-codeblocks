---
import * as lucide from 'lucide-static';
import { titles } from '../markdown.ts';
import { sidebar } from '../sidebar.mjs';
import { pageHref } from './feature-link.ts';

const icons: Record<string, string> = {
  'features/annotations': lucide.MessageSquareMore,
  'features/footnotes': lucide.Superscript,
  'features/inline-callouts': lucide.StickyNote,
  'features/side-by-side-annotations': lucide.Columns2,
  'features/scrollycoding': lucide.ScrollText,
  'features/focus': lucide.Focus,
  'features/line-states': lucide.TriangleAlert,
  'features/code-mentions': lucide.AtSign,
  'features/word-level-diff': lucide.Diff,
  'features/code-walkthrough': lucide.Replace,
  'features/hidden-lines': lucide.EyeOff,
  'features/expandable-blocks': lucide.ChevronsUpDown,
  'features/visible-whitespace': lucide.Pilcrow,
  'features/colourised-brackets': lucide.Braces,
  'features/inline-code-highlighting': lucide.Highlighter,
  'features/token-links': lucide.Link,
  'features/api-auto-linking': lucide.BookOpen,
  'features/line-permalinks': lucide.Hash,
  'features/code-switcher': lucide.ArrowLeftRight,
  'features/fill-in-placeholders': lucide.TextCursorInput,
  'features/smart-shell-copy': lucide.SquareTerminal,
  'features/open-in-playground': lucide.SquareArrowOutUpRight,
  'features/run-in-the-browser': lucide.Play,
};

// Shared syntax, not a feature in its own right: authors learn it under "Start here" but it gets no carousel slide.
const excluded = new Set(['features/comment-notation']);
const features = sidebar
  .flatMap(({ items }) => items)
  .filter((item): item is string => typeof item === 'string' && item.startsWith('features/') && !excluded.has(item))
  .map((id) => {
    const icon = icons[id];
    if (!icon) throw new Error(`<FeatureCarousel> has no icon for ${id}`);
    return { id, title: titles.get(id) ?? id, icon, href: pageHref(id) };
  });

const slides = await Astro.slots.render('default');
const order = features.map(({ id }) => slides.indexOf(`data-feature="${id}"`));
const missing = features.filter((_, i) => order[i] === -1);
if (missing.length) throw new Error(`<FeatureCarousel> has no slide for ${missing.map((f) => f.id).join(', ')}`);
if (order.some((at, i) => i > 0 && at < (order[i - 1] ?? 0)))
  throw new Error('<FeatureCarousel> slides must be in sidebar order');
---

<section class="carousel" aria-roledescription="carousel" aria-label="Features" data-interval="7000">
  <ul class="picker not-content">
    {
      features.map((feature) => (
        <li>
          <a class="tile" href={feature.href} data-feature={feature.id}>
            <span class="icon" aria-hidden="true" set:html={feature.icon} />
            {feature.title}
          </a>
        </li>
      ))
    }
  </ul>
  <div class="card">
    <div class="slides" set:html={slides} />
  </div>
  <div class="controls not-content">
    <button type="button" class="nav prev" hidden>
      <span aria-hidden="true" set:html={lucide.ChevronLeft} />
      Previous<span class="sr-only">feature</span>
    </button>
    <div class="dots" role="group" aria-label="Slides" hidden>
      {
        features.map((feature, i) => (
          <button
            type="button"
            class="dot"
            data-feature={feature.id}
            aria-label={`Show slide ${i + 1}: ${feature.title}`}
            aria-current={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            <span class="bullet">
              <span class="fill" />
            </span>
          </button>
        ))
      }
    </div>
    <button type="button" class="nav next" hidden>
      Next<span class="sr-only">feature</span>
      <span aria-hidden="true" set:html={lucide.ChevronRight} />
    </button>
    <button type="button" class="rotation" hidden>
      <span class="pause"><span aria-hidden="true" set:html={lucide.Pause} />Pause</span>
      <span class="play"><span aria-hidden="true" set:html={lucide.Play} />Play</span>
    </button>
  </div>
  <p class="sr-only" aria-live="polite" data-status></p>
</section>

<script>
  const root = document.querySelector<HTMLElement>('.carousel');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
    const status = root.querySelector('[data-status]') as HTMLElement;
    const rotation = root.querySelector('.rotation') as HTMLButtonElement;
    const prevBtn = root.querySelector('.nav.prev') as HTMLButtonElement;
    const nextBtn = root.querySelector('.nav.next') as HTMLButtonElement;
    const dotsWrap = root.querySelector('.dots') as HTMLElement;
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.dot')];
    const interval = Number(root.dataset.interval);
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let playing = !reduce.matches;
    let hovered = false;
    let focused = false;
    let timer: ReturnType<typeof setTimeout> | undefined;

    // Grows the current dot's fill towards the next auto-advance, as a CSS transition (so it animates in real
    // time regardless of the interval's fake-clock tests); frozen at its current width, not reset, while paused.
    let elapsed = 0;
    let startedAt: number | null = null;

    const currentFill = () => dots[current]?.querySelector<HTMLElement>('.fill');

    const startProgress = () => {
      if (reduce.matches) return;
      const fill = currentFill();
      if (!fill) return;
      startedAt = Date.now();
      fill.style.transitionDuration = `${interval - elapsed}ms`;
      fill.style.width = '100%';
    };

    const stopProgress = () => {
      if (startedAt !== null) {
        elapsed = Math.min(interval, elapsed + (Date.now() - startedAt));
        startedAt = null;
      }
      const fill = currentFill();
      if (fill) {
        const width = getComputedStyle(fill).width;
        fill.style.transitionDuration = '0s';
        fill.style.width = width;
      }
    };

    const resetProgress = () => {
      startedAt = null;
      elapsed = 0;
      const fill = currentFill();
      if (fill) {
        fill.style.transitionDuration = '0s';
        fill.style.width = '0%';
        fill.offsetWidth; // Force a reflow, so the 0s/0% reset commits before startProgress animates from it.
      }
    };

    const header = document.querySelector<HTMLElement>('.header');

    // Scrolls the card into view only far enough to matter: nothing if it's already half visible,
    // otherwise the least distance that gets it fully in view, or (if it's taller than the space
    // below the sticky header) that puts its top just below the header.
    const revealCard = () => {
      const card = root.querySelector('.card') as HTMLElement;
      const headerHeight = header?.getBoundingClientRect().height ?? 0;
      const viewportHeight = window.innerHeight;
      const available = viewportHeight - headerHeight;
      const rect = card.getBoundingClientRect();
      const visible = Math.max(0, Math.min(rect.bottom, viewportHeight) - Math.max(rect.top, headerHeight));
      if (visible / Math.min(rect.height, available) >= 0.5) return;
      const top =
        rect.height > available || rect.top < headerHeight ? rect.top - headerHeight : rect.bottom - viewportHeight;
      window.scrollBy({ top, behavior: reduce.matches ? 'auto' : 'smooth' });
    };

    const tiles = [...root.querySelectorAll<HTMLAnchorElement>('a.tile')].map((link) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = link.className;
      button.dataset.feature = link.dataset.feature;
      button.append(...link.childNodes);
      link.replaceWith(button);
      return button;
    });

    const schedule = () => {
      clearTimeout(timer);
      if (playing && !hovered && !focused) {
        timer = setTimeout(() => show(current + 1), interval);
        startProgress();
      } else {
        stopProgress();
      }
    };

    const show = (index: number, byUser = false) => {
      current = (index + slides.length) % slides.length;
      const slide = slides[current] as HTMLElement;
      for (const s of slides) s.toggleAttribute('data-current', s === slide);
      for (const t of tiles) t.setAttribute('aria-pressed', String(t.dataset.feature === slide.dataset.feature));
      for (const [i, dot] of dots.entries()) {
        dot.setAttribute('aria-current', String(i === current));
        dot.tabIndex = i === current ? 0 : -1;
      }
      resetProgress();
      if (byUser) status.textContent = `${slide.getAttribute('aria-label')}, ${current + 1} of ${slides.length}`;
      schedule();
    };

    const setPlaying = (value: boolean) => {
      playing = value;
      rotation.toggleAttribute('data-playing', playing);
      schedule();
    };

    const pick = (index: number, reveal = false) => {
      setPlaying(false);
      show(index, true);
      if (reveal) revealCard();
    };

    for (const [i, tile] of tiles.entries()) tile.addEventListener('click', () => pick(i, true));
    for (const [i, dot] of dots.entries()) dot.addEventListener('click', () => pick(i));
    // Roving tabindex (WAI carousel pattern): arrow keys move focus and jump to that slide.
    dotsWrap.addEventListener('keydown', (event) => {
      const i = dots.indexOf(document.activeElement as HTMLButtonElement);
      if (i === -1) return;
      const moves: Record<string, number> = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: dots.length - 1 };
      const next = moves[event.key];
      if (next === undefined) return;
      event.preventDefault();
      pick(next);
      dots[current]?.focus();
    });
    prevBtn.addEventListener('click', () => pick(current - 1, true));
    nextBtn.addEventListener('click', () => pick(current + 1, true));
    rotation.addEventListener('click', () => setPlaying(!playing));
    root.addEventListener('mouseenter', () => {
      hovered = true;
      schedule();
    });
    root.addEventListener('mouseleave', () => {
      hovered = false;
      schedule();
    });
    // Focus on the rotation control must not pause, or Play would do nothing until focus leaves.
    root.addEventListener('focusin', (event) => {
      focused = event.target !== rotation;
      schedule();
    });
    root.addEventListener('focusout', (event) => {
      if (!root.contains(event.relatedTarget as Node | null)) focused = false;
      schedule();
    });

    for (const control of [rotation, prevBtn, nextBtn, dotsWrap]) control.hidden = false;
    rotation.toggleAttribute('data-playing', playing);
    root.toggleAttribute('data-ready', true);
    show(0);
  }
</script>

<style>
  .carousel {
    margin-top: 1.5rem;
  }
  .card {
    padding: clamp(1rem, 0.25rem + 2.5vw, 2rem);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background-color: var(--sl-color-black);
  }
  .slides {
    display: grid;
  }
  .slides > :global(.slide) {
    margin: 0;
  }
  .carousel:not([data-ready]) .slides > :global(.slide:not(:first-child)),
  .carousel[data-ready] .slides > :global(.slide:not([data-current])) {
    visibility: hidden;
    opacity: 0;
  }
  .carousel[data-ready] .slides > :global(.slide.tall:not([data-current])) {
    display: none;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 1rem;
  }
  .dots {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
  }
  .dots[hidden] {
    display: none;
  }
  .dot {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    border: none;
    border-radius: 999rem;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .bullet {
    position: relative;
    display: block;
    width: 0.5rem;
    height: 0.5rem;
    overflow: hidden;
    border-radius: 999rem;
    background: var(--sl-color-gray-3);
    transition: width 0.2s;
  }
  .dot:hover .bullet {
    background: var(--sl-color-gray-2);
  }
  .dot[aria-current='true'] .bullet {
    width: 1.25rem;
  }
  .fill {
    position: absolute;
    inset: 0;
    width: 0%;
    background: var(--sl-color-text-accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .bullet {
      transition: none;
    }
  }
  @media (forced-colors: active) {
    .dot[aria-current='true'] .bullet {
      outline: 2px solid Highlight;
    }
  }
  .nav,
  .rotation {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    font: inherit;
    font-size: var(--sl-text-sm);
    cursor: pointer;
  }
  .nav {
    gap: 0.375rem;
  }
  .nav[hidden],
  .rotation[hidden] {
    display: none;
  }
  .nav:hover,
  .rotation:hover {
    border-color: var(--sl-color-gray-2);
  }
  .rotation > span {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }
  .rotation:not([data-playing]) .pause,
  .rotation[data-playing] .play {
    display: none;
  }
  .nav :global(svg),
  .rotation :global(svg),
  .icon :global(svg) {
    display: block;
    width: 1rem;
    height: 1rem;
  }
  /* Columns, so that the tiles read down each column in sidebar order, as the tab order goes.
     Below 44rem, "14rem" would still fit only one column, so it's forced to two (still column-major,
     an even 12/11 split) up to where the auto column width would take over and give three anyway. */
  .picker {
    columns: 14rem;
    column-gap: 0.5rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
  }
  @media (max-width: 44rem) {
    .picker {
      columns: 2;
    }
  }
  .picker > li {
    break-inside: avoid;
    padding-bottom: 0.5rem;
  }
  .tile {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    width: 100%;
    min-height: 2.75rem;
    padding: 0.375rem 0.75rem 0.375rem 0.375rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--sl-color-white);
    font: inherit;
    font-size: var(--sl-text-sm);
    line-height: 1.3;
    text-align: start;
    text-decoration: none;
    cursor: pointer;
  }
  /* Narrower tiles at two columns: the label may wrap to two lines, so every tile gets the
     same min-height (not just the wrapped ones), keeping rows aligned across both columns. */
  @media (max-width: 44rem) {
    .tile {
      gap: 0.5rem;
      min-height: 3.25rem;
      padding: 0.375rem 0.5rem 0.375rem 0.375rem;
      font-size: var(--sl-text-xs);
    }
  }
  .tile:hover {
    border-color: var(--sl-color-gray-2);
  }
  .icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.375rem;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-text-accent);
  }
  @media (max-width: 44rem) {
    .icon {
      width: 1.75rem;
      height: 1.75rem;
    }
  }
  .tile[aria-pressed='true'] {
    border-color: var(--sl-color-text-accent);
    box-shadow: inset 0 0 0 1px var(--sl-color-text-accent);
    font-weight: 600;
  }
  .tile[aria-pressed='true'] .icon {
    background: var(--sl-color-text-accent);
    color: var(--sl-color-black);
  }
  @media (forced-colors: active) {
    .tile[aria-pressed='true'] {
      outline: 2px solid Highlight;
    }
  }
</style>
