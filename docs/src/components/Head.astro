---
import Default from '@astrojs/starlight/components/Head.astro';
import { pageUrl, siteUrl, titles } from '../markdown.ts';

const id = Astro.locals.starlightRoute.entry.id || 'index';
const image = new URL(`og/${titles.has(id) ? id : 'index'}.png`, siteUrl).href;
---

<Default><slot /></Default>
{titles.has(id) && <link rel="alternate" type="text/markdown" href={pageUrl(id, true)} />}
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={Astro.locals.starlightRoute.entry.data.title} />
<meta name="twitter:image" content={image} />
