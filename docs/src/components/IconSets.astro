---
import { iconSetNames, iconSetTables } from './icon-sets.ts';

interface Props {
  /** `top` for common files, `languages` for every Shiki language, `files` for file names with their own icons. */
  rows?: keyof typeof iconSetTables;
}

const { rows = 'top' } = Astro.props;
const label = rows === 'languages' ? 'Language' : 'File';
---

<table class="icon-sets">
  <thead>
    <tr>
      <th scope="col">{label}</th>
      {iconSetNames.map((name) => <th scope="col">{name.replace('Catppuccin', 'Catppuc\u00adcin')}</th>)}
    </tr>
  </thead>
  <tbody>
    {
      iconSetTables[rows].map((row) => (
        <tr>
          <th scope="row">
            {row.label}
            {row.title && row.label !== row.title && <code>{row.title}</code>}
          </th>
          {row.icons.map((icon) => (
            <td title={icon.name}>
              <span class="icons not-content" set:html={icon.html} />
              <span class="sr-only">{icon.name}</span>
            </td>
          ))}
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .icon-sets th[scope='row'] {
    font-weight: 400;
  }
  .icon-sets th[scope='row'] code {
    margin-inline-start: 0.5em;
    font-size: var(--sl-text-xs);
  }
  .icon-sets td {
    text-align: center;
    vertical-align: middle;
  }
  .icons {
    display: block;
  }
  /* Five columns fit a phone only with a fixed layout, and names that wrap. */
  @media (max-width: 50rem) {
    .icon-sets {
      table-layout: fixed;
      width: 100%;
    }
    .icon-sets thead th {
      font-size: 0.6875rem;
    }
    .icon-sets thead th:not(:first-child) {
      width: 3.5rem;
    }
    .icon-sets th,
    .icon-sets td {
      padding-inline: 0.25rem;
    }
    .icon-sets th[scope='row'] {
      overflow-wrap: anywhere;
    }
    .icon-sets th[scope='row'] code {
      display: block;
      margin-inline-start: 0;
    }
  }
  .icon-sets :global(.set-icon) {
    display: block;
    width: calc(1.25rem * var(--scale, 1));
    height: calc(1.25rem * var(--scale, 1));
    margin-inline: auto;
  }
  :global(:root[data-theme='light']) .icon-sets :global([data-variant='dark']),
  :global(:root:not([data-theme='light'])) .icon-sets :global([data-variant='light']) {
    display: none;
  }
</style>
