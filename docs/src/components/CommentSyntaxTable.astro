---
import { commentSyntaxGroups } from './reference.ts';
---

<table>
  <thead>
    <tr><th>Comment syntax</th><th>Languages</th></tr>
  </thead>
  <tbody>
    {
      commentSyntaxGroups.map(({ syntax, languages }) => (
        <tr>
          <td>{syntax.map((s, i) => <>{i > 0 && ', '}<code>{s}</code></>)}</td>
          <td>{languages.map((l, i) => <>{i > 0 && ', '}<code>{l}</code></>)}</td>
        </tr>
      ))
    }
  </tbody>
</table>
