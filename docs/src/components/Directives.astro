---
import { directives } from './reference.ts';
import { featureLink } from './feature-link.ts';
import { inlineCode } from './inline-code.ts';
import ReferenceEntry from './ReferenceEntry.astro';
---

{
  directives.map(({ id, label, placement, docs, example }) => (
    <ReferenceEntry
      id={id}
      labels={[label]}
      description={docs.description}
      facts={[
        ['Placement', placement],
        ['Arguments', docs.args ? inlineCode(docs.args) : 'None'],
        ['Feature', featureLink(docs.page)],
      ]}
      example={example}
    />
  ))
}
