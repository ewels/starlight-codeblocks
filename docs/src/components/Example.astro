---
import { Code, TabItem, Tabs } from '@astrojs/starlight/components';
import { keepTrailingWhitespace } from '../../../packages/starlight-codeblocks/src/expressive-code/whitespace.ts';

interface Props {
  /**
   * Markdown with one or more fenced code blocks. For Markdown that `<Code>` cannot render, such as
   * prose or a directive, put the same Markdown between the tags too. `scripts/examples.test.mjs` checks that they match.
   */
  code: string;
  /**
   * `side` puts the two panes next to each other when there is room, the output first. `tabs` puts
   * them in **Output** and **Source** tabs.
   */
  layout?: 'stack' | 'side' | 'tabs';
  /**
   * Attributes for the fence line of each rendered block that the source pane leaves out, such as
   * `apiLinks=false` to keep another feature out of the example. Live Markdown must include them.
   */
  hiddenAttributes?: string;
  /** The part of `astro.config.mjs` that the example needs, shown in the source pane after the Markdown. */
  config?: string;
}

const { code, layout = 'stack', hiddenAttributes = '', config } = Astro.props;
const live = Astro.slots.has('default');
const blocks = [...code.matchAll(/^(`{3,}|~{3,})([^\s`]*)[ \t]*(.*)\n([\s\S]*?)\n?^\1[ \t]*$/gm)].map(
  ([, , lang, meta, body]) => ({ lang, meta: `${meta} ${hiddenAttributes}`.trim(), code: body }),
);
// The source shows what authors write, so colours in it get no swatches.
// With a config, each source block needs a title to tell them apart.
const sourceMeta = keepTrailingWhitespace(
  code.trim(),
  config ? 'swatches=false title="src/content/docs/guide.md"' : 'swatches=false',
);
if (!live && blocks.length === 0) throw new Error(`<Example> found no fenced code block in:\n${code}`);
---

{
  layout === 'tabs' ? (
    <div class="example tabs">
      <Tabs>
        <TabItem label="Output">
          <div class:list={['pane output', { 'not-content': !live }]}>
            {live ? <slot /> : blocks.map((block) => <Code {...block} />)}
          </div>
        </TabItem>
        <TabItem label="Source">
          <div class="pane source not-content">
            <Code code={code.trim()} lang="md" meta={sourceMeta} />
            {config && <Code code={config.trim()} lang="js" title="astro.config.mjs" />}
          </div>
        </TabItem>
      </Tabs>
    </div>
  ) : (
    <div class:list={['example', layout]}>
      <div class:list={['pane output', { 'not-content': !live }]}>
        <p class="label not-content">Readers see</p>
        {live ? <slot /> : blocks.map((block) => <Code {...block} />)}
      </div>
      <div class="pane source not-content">
        <p class="label">You write</p>
        <Code code={code.trim()} lang="md" meta={sourceMeta} />
        {config && <Code code={config.trim()} lang="js" title="astro.config.mjs" />}
      </div>
    </div>
  )
}

<style>
  .example {
    margin-top: 1.5rem;
  }
  .stack > .pane + .pane {
    margin-top: 1rem;
  }
  .side {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .side > .pane {
    flex: 1 1 17rem;
    min-width: 0;
    margin-top: 0;
  }
  .pane > :global(* + *) {
    margin-top: 0.875rem;
  }
  .label {
    margin: 0 0 0.375rem;
    font-size: var(--sl-text-sm);
    font-style: italic;
    color: var(--sl-color-gray-3);
  }
</style>
