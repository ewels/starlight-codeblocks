---
import { Code } from '@astrojs/starlight/components';

interface Props {
  /**
   * Markdown with one or more fenced code blocks. For Markdown that `<Code>` cannot render, such as
   * prose or a directive, put the same Markdown between the tags too. `scripts/examples.test.mjs` checks that they match.
   */
  code: string;
}

const { code } = Astro.props;
const live = Astro.slots.has('default');
const blocks = [...code.matchAll(/^(`{3,}|~{3,})([^\s`]*)[ \t]*(.*)\n([\s\S]*?)\n?^\1[ \t]*$/gm)].map(
  ([, , lang, meta, body]) => ({ lang, meta, code: body }),
);
if (!live && blocks.length === 0) throw new Error(`<Example> found no fenced code block in:\n${code}`);
---

<div class="example">
  <div class="pane not-content">
    <p class="label">You write</p>
    <Code code={code.trim()} lang="md" />
  </div>
  <div class:list={['pane', { 'not-content': !live }]}>
    <p class="label not-content">Readers see</p>
    {live ? <slot /> : blocks.map((block) => <Code {...block} />)}
  </div>
</div>

<style>
  .example {
    margin-top: 1.5rem;
  }
  .pane + .pane {
    margin-top: 1rem;
  }
  .pane > :global(* + *) {
    margin-top: 0.875rem;
  }
  .label {
    margin: 0 0 0.375rem;
    font-size: var(--sl-text-sm);
    font-style: italic;
    color: var(--sl-color-gray-3);
  }
</style>
