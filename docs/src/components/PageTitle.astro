---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { getCollection } from 'astro:content';
import { pageUrl } from '../markdown.ts';

const ids = new Set((await getCollection('docs')).map((entry) => entry.id));
const id = Astro.locals.starlightRoute.entry.id || 'index';
const markdown = pageUrl(id, true);
const path = new URL(markdown).pathname;
const prompt = encodeURIComponent(
  `Read ${markdown}. It is a page of the docs for starlight-codeblocks, a plugin that adds features to the code blocks of Starlight sites. I want to ask questions about it.`,
);
---

<Default />
{
  ids.has(id) && (
    <div class="page-actions not-content">
      <button type="button" class="page-action" data-copy-markdown={path} hidden>
        Copy as Markdown
      </button>
      <a class="page-action" href={path}>View as Markdown</a>
      <a class="page-action" href={`https://claude.ai/new?q=${prompt}`}>Open in Claude</a>
      <a class="page-action" href={`https://chatgpt.com/?q=${prompt}`}>Open in ChatGPT</a>
      <span class="sr-only" role="status" />
    </div>
  )
}

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-markdown]')) {
    const status = button.parentElement?.querySelector('[role="status"]');
    const label = button.textContent;
    let timer: ReturnType<typeof setTimeout> | undefined;
    button.hidden = false;
    button.addEventListener('click', async () => {
      let text = 'Copied';
      try {
        const response = await fetch(button.dataset.copyMarkdown ?? '');
        if (!response.ok) throw new Error(String(response.status));
        await navigator.clipboard.writeText(await response.text());
      } catch {
        text = 'Copy failed';
      }
      button.textContent = text;
      if (status) status.textContent = text === 'Copied' ? 'Copied the page as Markdown' : text;
      clearTimeout(timer);
      timer = setTimeout(() => {
        button.textContent = label;
        if (status) status.textContent = '';
      }, 2000);
    });
  }
</script>

<style>
  .page-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .page-action {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-sm);
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
  }
  .page-action[hidden] {
    display: none;
  }
  .page-action:hover {
    border-color: var(--sl-color-gray-3);
    color: var(--sl-color-white);
  }
  .page-action:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
</style>
