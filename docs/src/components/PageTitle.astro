---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { Icon } from '@astrojs/starlight/components';
import { pageUrl, titles } from '../markdown.ts';
// Build time only: this reads the path data below, the package never reaches the browser.
// npm view simple-icons license -> CC0-1.0. Version pinned in package.json.
import { siClaude } from 'simple-icons';

const id = Astro.locals.starlightRoute.entry.id || 'index';
const markdown = pageUrl(id, true);
const path = new URL(markdown).pathname;
const prompt = encodeURIComponent(
  `Read ${markdown}. It is a page of the docs for starlight-codeblocks, a plugin that adds features to the code blocks of Starlight sites. I want to ask questions about it.`,
);
const claudeHref = `https://claude.ai/new?q=${prompt}`;
const chatgptHref = `https://chatgpt.com/?q=${prompt}`;
---

<Default />
{
  titles.has(id) && (
    <div class="page-actions not-content">
      <div class="split-button">
        <button type="button" class="page-action split-button-main" data-copy-markdown={path} hidden>
          Copy as Markdown
        </button>
        <button
          type="button"
          class="page-action split-button-caret"
          popovertarget="page-actions-menu"
          aria-haspopup="menu"
          aria-expanded="false"
          aria-label="More page actions"
        >
          <Icon name="down-caret" />
        </button>
        <div id="page-actions-menu" class="page-actions-menu" popover="auto" role="menu" aria-label="Page actions">
          <a role="menuitem" tabindex="-1" class="page-actions-menu-item" href={path}>
            <Icon name="add-document" class="page-actions-menu-icon" /> View as Markdown
          </a>
          <a role="menuitem" tabindex="-1" class="page-actions-menu-item" href={claudeHref}>
            <svg
              class="page-actions-menu-icon"
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="currentColor"
              set:html={`<path d="${siClaude.path}"/>`}
            /> Open in Claude
          </a>
          <a role="menuitem" tabindex="-1" class="page-actions-menu-item" href={chatgptHref}>
            <Icon name="comment-alt" class="page-actions-menu-icon" /> Open in ChatGPT
          </a>
        </div>
      </div>
      <div class="page-actions-fallback">
        <a class="page-action" href={path}>View as Markdown</a>
        <a class="page-action" href={claudeHref}>Open in Claude</a>
        <a class="page-action" href={chatgptHref}>Open in ChatGPT</a>
      </div>
      <span class="sr-only" role="status" />
    </div>
  )
}

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-markdown]')) {
    const status = button.closest('.page-actions')?.querySelector('[role="status"]');
    const label = button.textContent;
    let timer: ReturnType<typeof setTimeout> | undefined;
    button.hidden = false;
    button.addEventListener('click', async () => {
      let text = 'Copied';
      try {
        const response = await fetch(button.dataset.copyMarkdown ?? '');
        if (!response.ok) throw new Error(String(response.status));
        await navigator.clipboard.writeText(await response.text());
      } catch {
        text = 'Copy failed';
      }
      button.textContent = text;
      if (status) status.textContent = text === 'Copied' ? 'Copied the page as Markdown' : text;
      clearTimeout(timer);
      timer = setTimeout(() => {
        button.textContent = label;
        if (status) status.textContent = '';
      }, 2000);
    });
  }

  for (const menu of document.querySelectorAll<HTMLElement>('.page-actions-menu')) {
    const trigger = menu.closest('.split-button')?.querySelector<HTMLButtonElement>('.split-button-caret');
    if (!trigger) continue;
    const items = () => [...menu.querySelectorAll<HTMLElement>('[role="menuitem"]')];

    const place = () => {
      const rect = trigger.getBoundingClientRect();
      menu.style.top = `${rect.bottom + 4}px`;
      menu.style.left = `${Math.max(8, rect.right - menu.offsetWidth)}px`;
    };

    menu.addEventListener('toggle', (event) => {
      const open = (event as ToggleEvent).newState === 'open';
      trigger.setAttribute('aria-expanded', String(open));
      if (open) {
        place();
        items()[0]?.focus();
        addEventListener('scroll', place, { passive: true, capture: true });
        addEventListener('resize', place);
      } else {
        trigger.focus();
        removeEventListener('scroll', place, { capture: true });
        removeEventListener('resize', place);
      }
    });

    menu.addEventListener('keydown', (event) => {
      const list = items();
      const index = list.indexOf(document.activeElement as HTMLElement);
      if (event.key === 'Tab') return menu.hidePopover();
      const moves: Record<string, number> = { ArrowDown: index + 1, ArrowUp: index - 1, Home: 0, End: -1 };
      const next = moves[event.key];
      if (next === undefined) return;
      event.preventDefault();
      list.at(next % list.length)?.focus();
    });
  }
</script>

<style>
  .page-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .split-button {
    display: inline-flex;
  }
  .page-action {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    background: transparent;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-sm);
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
  }
  .split-button-main {
    border-radius: 0.375rem 0 0 0.375rem;
  }
  .split-button-main[hidden] {
    display: none;
  }
  .split-button-caret {
    min-width: 2rem;
    padding: 0 0.5rem;
    border-radius: 0 0.375rem 0.375rem 0;
    margin-left: -1px;
  }
  .split-button:has(.split-button-main[hidden]) .split-button-caret {
    border-radius: 0.375rem;
    margin-left: 0;
  }
  .page-action:hover {
    border-color: var(--sl-color-gray-3);
    color: var(--sl-color-white);
  }
  .page-action:focus-visible {
    position: relative;
    z-index: 1;
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
  .page-actions-menu {
    position: fixed;
    inset: unset;
    margin: 0;
    min-width: 12rem;
    padding: 0.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: var(--sl-color-bg-nav);
    box-shadow: var(--sl-shadow-md);
    color: inherit;
    font-size: var(--sl-text-sm);
  }
  .page-actions-menu-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 24px;
    padding: 0.5rem 0.75rem;
    border-radius: 0.25rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  .page-actions-menu-item:hover,
  .page-actions-menu-item:focus-visible {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }
  .page-actions-menu-item:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: -2px;
  }
  .page-actions-menu-icon {
    width: 1em;
    height: 1em;
    flex-shrink: 0;
  }
  .page-actions-fallback {
    display: none;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .page-actions-fallback .page-action {
    border-radius: 0.375rem;
  }
  @media (scripting: none) {
    .split-button {
      display: none;
    }
    .page-actions-fallback {
      display: flex;
    }
  }
</style>
